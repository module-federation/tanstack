{
  "name": "@module-federation/tanstack",
  "version": "0.0.0",
  "type": "module",
  "description": "TanStack Start integration for Module Federation",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./rsbuild": {
      "import": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.js"
      },
      "require": {
        "types": "./dist/rsbuild.d.cts",
        "default": "./dist/rsbuild.cjs"
      }
    },
    "./node-entry-loader": {
      "import": {
        "types": "./dist/node-entry-loader.d.ts",
        "default": "./dist/node-entry-loader.js"
      },
      "require": {
        "types": "./dist/node-entry-loader.d.cts",
        "default": "./dist/node-entry-loader.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/tanstack.git",
    "directory": "packages/tanstack"
  },
  "bugs": {
    "url": "https://github.com/module-federation/tanstack/issues"
  },
  "homepage": "https://github.com/module-federation/tanstack#readme",
  "keywords": [
    "tanstack",
    "tanstack-start",
    "module-federation",
    "microfrontend"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rslib build --lib cjs && rslib build --lib esm --no-clean",
    "dev": "rslib build --watch",
    "pack:dry": "npm pack --dry-run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.0",
    "@module-federation/vite": "^1.23.3",
    "@rsbuild/core": "^2.0.0",
    "@tanstack/react-start": "^1.167.43",
    "react": ">=18.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    },
    "@module-federation/rsbuild-plugin": {
      "optional": true
    },
    "@module-federation/vite": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.9.2",
    "@module-federation/runtime": "2.9.2",
    "@module-federation/vite": "1.23.3",
    "@rsbuild/core": "2.2.11",
    "@rslib/core": "1.0.3",
    "@tanstack/react-start": "1.168.60",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
