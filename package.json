{
  "name": "mf-tanstack",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:package": "pnpm --filter @module-federation/tanstack build",
    "dev": "pnpm build:package && turbo run dev",
    "test": "pnpm build && pnpm test:core && pnpm test:e2e",
    "test:core": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "pack:tanstack": "pnpm --filter @module-federation/tanstack pack:dry",
    "start": "pnpm build:package && turbo run start",
    "preview": "pnpm build && turbo run preview"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "playwright": "1.63.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
