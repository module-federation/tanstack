    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.9.0",
    "@module-federation/tanstack": "workspace:*",
    "@rsbuild/core": "2.2.8",
    "@rsbuild/plugin-react": "2.1.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
