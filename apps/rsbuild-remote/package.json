{
  "name": "tanstack-start-rsbuild-remote",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --port 3002 --strict-port",
    "start": "rsbuild dev --host 127.0.0.1 --port 3002 --strict-port",
    "preview": "rsbuild preview --host 127.0.0.1 --port 3002",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@module-federation/runtime": "2.9.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "example-host-context": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.9.2",
    "@module-federation/tanstack": "workspace:*",
    "@rsbuild/core": "2.2.11",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
